# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your actual values.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Get your free API key from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional: PDFMonkey for cloud PDF generation (leave blank for local fallback)
PDFMONKEY_API_KEY=your_pdfmonkey_api_key_here
PDFMONKEY_TEMPLATE_ID=your_pdfmonkey_template_id_here
